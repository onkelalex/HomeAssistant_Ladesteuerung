blueprint:
  name: 🔋 Hausbatterie Steuerung mit Wallbox & Strompreis
  description: >
    Version 0.9.3

    Steuert eine Hoymiles/MS-A2 Hausbatterie bei Wallbox-Ladung,
    manuellem Sofortladen, dynamischem Preisladen und preisabhängiger
    Akku-Entladung.

    Änderungen in 0.9.3:
    - Wertet die 15-Minuten-Preise aus dem Tibber-Diagramm-Datenexport aus.
    - Berechnet bei 1,2 kW Ladeleistung aus SOC, Ziel-SOC und Kapazität automatisch
      die Anzahl der benötigten günstigen Viertelstunden.
    - Sucht die nächste Kostenspitze mit mindestens 10 ct/kWh Preisabstand und
      plant die Ladung gezielt in die günstigsten Zeitfenster vor dieser Spitze.
    - Gibt es keine solche Spitze, wird trotzdem in den günstigsten Zeitfenstern
      des Planungshorizonts geladen. Der Preisaufschlag sperrt nur die Entladung.
    - Der bisherige Preislade-Schalter aktiviert die gesamte Preisautomatik.
    - Der Akku entlädt nur, wenn der Preis gegenüber dem geplanten Ladepreis
      mindestens um den eingestellten Preisaufschlag höher liegt.
    - Die bisherige Lade-Preisgrenze kann optional als absolute Obergrenze dienen.
    - Der Entlade-Preisaufschlag ist als Eingabefeld im Blueprint konfigurierbar.
    - Der Mindestwert für den Entlade-Preisaufschlag ist 0,10 €/kWh.
    - Zusätzlich gibt es einen Schalter, um die Akku-Entladung komplett zu sperren.
    - Wenn Entladung nicht erlaubt ist, wird die Batterie auf mqtt_ctrl mit 0 W gesetzt.
    - Komma- und Punktwerte werden verarbeitet, z. B. 0,16 und 0.16.

    Logik:
    1. Sofortladen aktiv und SOC unter Zielwert → Akku lädt.
    2. Preisautomatik aktiv und aktuelles Viertel gehört zu den günstigsten
       benötigten Zeitfenstern → Akku lädt bis zum Ziel-SOC.
    3. Wallbox lädt → Akku-Entladung wird gestoppt.
    4. Entladung gesperrt → Akku bleibt neutral bei 0 W.
    5. Preisautomatik aktiv, aber Strompreis nicht teuer genug → Akku bleibt neutral.
    6. Preisautomatik aktiv und Strompreis teuer genug → Normalmodus.
    7. Preisautomatik aus → Normalmodus, sofern Wallbox/Entladesperre nicht greifen.

    Benötigte Helfer:
    - input_boolean für Sofortladen
    - input_boolean für automatisches Preisladen
    - input_boolean für Entladung sperren
    - input_number für Ziel-Ladestand
    - input_number für Lade-Preisgrenze in €/kWh

    Wichtig:
    Der Strompreis-Sensor und der Preisgrenzen-Helfer müssen beide in €/kWh arbeiten.
    Beispiel: 0,16 €/kWh entspricht 16 ct/kWh.
  domain: automation

  input:
    battery_mode_select:
      name: Batterie Betriebsmodus Select
      description: z. B. select.msa_280024230201_mqtt_select
      selector:
        entity:
          domain: select

    battery_power_number:
      name: Batterie Leistungs-Number
      description: z. B. number.msa_280024230201
      selector:
        entity:
          domain: number

    battery_soc_sensor:
      name: Batterie SOC Sensor
      description: z. B. sensor.msa_280024230201_state_of_charge_system
      selector:
        entity:
          domain: sensor

    wallbox_status_sensor:
      name: Wallbox Status Sensor
      description: z. B. sensor.easee_charge_up_status
      selector:
        entity:
          domain: sensor

    force_charge_switch:
      name: Sofortladen Schalter
      description: z. B. input_boolean.akku_sofort_laden
      selector:
        entity:
          domain: input_boolean

    price_charging_switch:
      name: Dynamische Preisautomatik Schalter
      description: z. B. input_boolean.akku_automatisches_preisladen
      selector:
        entity:
          domain: input_boolean

    price_chart_sensor:
      name: Tibber Diagramm-Datenexport
      description: >
        Sensor mit dem Attribut data und den Feldern start_time und price_per_kwh.
        Beispiel: sensor.zumbuschstr_1_diagramm_datenexport
      selector:
        entity:
          domain: sensor

    discharge_block_switch:
      name: Akku-Entladung sperren Schalter
      description: >
        input_boolean-Helfer zum Sperren der Akku-Entladung.
        Wenn dieser Schalter an ist, wird die Batterie nicht entladen.
        Laden bei günstigem Strompreis oder Sofortladen bleibt weiterhin möglich.
        Beispiel: input_boolean.akku_entladung_sperren
      selector:
        entity:
          domain: input_boolean

    target_soc_number:
      name: Ziel-Ladestand
      description: z. B. input_number.akku_ziel_ladestand
      selector:
        entity:
          domain: input_number

    price_threshold_number:
      name: Lade-Preisgrenze Helfer
      description: >
        input_number-Helfer für die Lade-Preisgrenze in €/kWh.
        Beispiel: 0,16 entspricht 16 ct/kWh.
      selector:
        entity:
          domain: input_number

    use_price_ceiling:
      name: Lade-Preisgrenze als Obergrenze verwenden
      description: >
        Aus = allein die relativ günstigsten Viertelstunden entscheiden.
        An = zusätzlich muss der Preis unter dem Preisgrenzen-Helfer liegen.
      default: false
      selector:
        boolean: {}

    price_sensor:
      name: Strompreis Sensor
      description: >
        Sensor für den aktuellen Strompreis.
        Der State des Sensors muss den Preis in €/kWh liefern.
        Beispiel: 0,16 oder 0.16 entspricht 16 ct/kWh.
      selector:
        entity:
          domain: sensor

    allow_price_charge_while_wallbox:
      name: Preisladen auch während Wallbox-Ladung erlauben
      description: >
        Aus = Wallbox hat Priorität, Hausakku entlädt nicht und lädt auch nicht.
        An = Hausakku darf bei günstigem Preis auch während Wallbox-Ladung laden.
      default: false
      selector:
        boolean: {}

    charge_power:
      name: Ladeleistung
      description: >
        Negativer Wert lädt den Akku. Für deine beiden MS-A2 zusammen -1200.
      default: -1200
      selector:
        number:
          min: -3000
          max: 0
          step: 10
          mode: box
          unit_of_measurement: W

    battery_capacity:
      name: Nutzbare Gesamtkapazität
      description: Für zwei MS-A2 zusammen 4,48 kWh.
      default: 4.48
      selector:
        number:
          min: 0.1
          max: 100
          step: 0.01
          mode: box
          unit_of_measurement: kWh

    planning_horizon:
      name: Planungshorizont
      description: >
        Zeitraum, in dem die nächste Kostenspitze und die davorliegenden
        günstigen Viertelstunden gesucht werden.
        Sind noch keine Preise für morgen vorhanden, werden nur die vorhandenen Daten genutzt.
      default: 24
      selector:
        number:
          min: 4
          max: 48
          step: 1
          mode: box
          unit_of_measurement: h

    neutral_power:
      name: Neutralleistung
      description: Normalerweise 0 W.
      default: 0
      selector:
        number:
          min: -3000
          max: 3000
          step: 10
          mode: box
          unit_of_measurement: W

    discharge_price_offset:
      name: Entladen erst ab Preisaufschlag
      description: >
        Aufschlag auf die Lade-Preisgrenze, ab dem der Akku wieder entladen darf.
        Angabe in €/kWh. Der Mindestwert ist 0,10 €/kWh, also 10 ct/kWh.
        Beispiel: Bei Lade-Preisgrenze 0,16 €/kWh und Aufschlag 0,10 €/kWh
        darf der Akku erst ab 0,26 €/kWh wieder entladen.
      default: 0.10
      selector:
        number:
          min: 0.10
          max: 1
          step: 0.001
          mode: box
          unit_of_measurement: "€/kWh"

    wallbox_charging_state:
      name: Wallbox Status für "lädt"
      description: Bei Easee normalerweise charging.
      default: charging
      selector:
        text: {}

    control_mode_option:
      name: Batterie Steuerungsmodus
      description: Bei MS-A2 normalerweise mqtt_ctrl.
      default: mqtt_ctrl
      selector:
        text: {}

    normal_mode_option:
      name: Batterie Normalmodus
      description: Bei MS-A2 normalerweise general.
      default: general
      selector:
        text: {}

trigger:
  - platform: state
    entity_id: !input wallbox_status_sensor
    id: wallbox_changed

  - platform: state
    entity_id: !input force_charge_switch
    id: force_charge_changed

  - platform: state
    entity_id: !input price_charging_switch
    id: price_charging_switch_changed

  - platform: state
    entity_id: !input discharge_block_switch
    id: discharge_block_changed

  - platform: state
    entity_id: !input target_soc_number
    id: target_soc_changed

  - platform: state
    entity_id: !input price_threshold_number
    id: price_threshold_changed

  - platform: state
    entity_id: !input battery_soc_sensor
    id: soc_changed

  - platform: state
    entity_id: !input price_sensor
    id: price_changed

  - platform: state
    entity_id: !input price_chart_sensor
    id: price_chart_changed

  - platform: time_pattern
    seconds: "/30"
    id: repeat_send

condition: []

action:
  - variables:
      battery_soc_sensor_var: !input battery_soc_sensor
      target_soc_number_var: !input target_soc_number
      price_threshold_number_var: !input price_threshold_number
      price_sensor_var: !input price_sensor
      price_chart_sensor_var: !input price_chart_sensor
      wallbox_status_sensor_var: !input wallbox_status_sensor
      force_charge_switch_var: !input force_charge_switch
      price_charging_switch_var: !input price_charging_switch
      discharge_block_switch_var: !input discharge_block_switch

      allow_price_charge_while_wallbox_var: !input allow_price_charge_while_wallbox
      use_price_ceiling_var: !input use_price_ceiling
      charge_power_var: !input charge_power
      battery_capacity_var: !input battery_capacity
      planning_horizon_var: !input planning_horizon
      neutral_power_var: !input neutral_power
      discharge_price_offset_var: !input discharge_price_offset
      wallbox_charging_state_var: !input wallbox_charging_state
      control_mode_option_var: !input control_mode_option
      normal_mode_option_var: !input normal_mode_option

      soc: >
        {{ (states(battery_soc_sensor_var) | string | replace(',', '.')) | float(999) }}

      target_soc: >
        {{ (states(target_soc_number_var) | string | replace(',', '.')) | float(0) }}

      price: >
        {{ (states(price_sensor_var) | string | replace(',', '.')) | float(999) }}

      price_threshold: >
        {{ (states(price_threshold_number_var) | string | replace(',', '.')) | float(0.16) }}

      chart_data: >
        {{ state_attr(price_chart_sensor_var, 'data') or [] }}

      remaining_energy_kwh: >
        {{ [0, (battery_capacity_var | float(4.48)) * ((target_soc | float(0)) - (soc | float(999))) / 100] | max }}

      energy_per_slot_kwh: >
        {{ ((charge_power_var | float(-1200)) | abs) / 1000 * 0.25 }}

      required_slots: >
        {% set per_slot = ((charge_power_var | float(-1200)) | abs) / 1000 * 0.25 %}
        {% set energy = [0, (battery_capacity_var | float(4.48)) * ((target_soc | float(0)) - (soc | float(999))) / 100] | max %}
        {{ (energy / per_slot) | round(0, 'ceil') | int if per_slot > 0 else 0 }}

      next_peak_start_ts: >
        {% set ns = namespace(lowest=999, peak=0) %}
        {% set end_ts = as_timestamp(now()) + (planning_horizon_var | float(24)) * 3600 %}
        {% for item in chart_data if item is mapping %}
          {% set start_ts = as_timestamp(item.start_time, 0) %}
          {% set item_price = item.price_per_kwh | float(999) %}
          {% if start_ts > 0 and start_ts + 900 > as_timestamp(now()) and start_ts < end_ts and item_price < 999 %}
            {% if item_price < ns.lowest %}
              {% set ns.lowest = item_price %}
            {% endif %}
            {% if ns.peak == 0 and item_price >= ns.lowest + (discharge_price_offset_var | float(0.10)) %}
              {% set ns.peak = start_ts %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {{ ns.peak }}

      charge_window_prices: >
        {% set ns = namespace(values=[]) %}
        {% set peak_ts = next_peak_start_ts | float(0) %}
        {% set horizon_end = as_timestamp(now()) + (planning_horizon_var | float(24)) * 3600 %}
        {% set charge_end = peak_ts if peak_ts > 0 else horizon_end %}
        {% for item in chart_data if item is mapping %}
          {% set start_ts = as_timestamp(item.start_time, 0) %}
          {% set item_price = item.price_per_kwh | float(999) %}
          {% if start_ts > 0 and start_ts + 900 > as_timestamp(now()) and start_ts < charge_end and item_price < 999 %}
            {% set ns.values = ns.values + [item_price] %}
          {% endif %}
        {% endfor %}
        {{ ns.values }}

      planned_charge_price_limit: >
        {% set prices = charge_window_prices | list | sort %}
        {% set slots = required_slots | int(0) %}
        {% if prices | count > 0 and slots > 0 %}
          {{ prices[[slots, prices | count] | min - 1] | float(999) }}
        {% else %}
          {{ 999 }}
        {% endif %}

      discharge_reference_price: >
        {% set ns = namespace(lowest=999) %}
        {% set start_limit = as_timestamp(now()) - 24 * 3600 %}
        {% for item in chart_data if item is mapping %}
          {% set start_ts = as_timestamp(item.start_time, 0) %}
          {% set item_price = item.price_per_kwh | float(999) %}
          {% if start_ts >= start_limit and start_ts <= as_timestamp(now()) and item_price < ns.lowest %}
            {% set ns.lowest = item_price %}
          {% endif %}
        {% endfor %}
        {{ ns.lowest }}

      discharge_price_offset_value: >
        {{ discharge_price_offset_var | float(0.10) }}

      discharge_price_limit: >
        {% set cheap = discharge_reference_price | float(999) %}
        {% if cheap < 999 %}
          {{ cheap + (discharge_price_offset_var | float(0.10)) }}
        {% else %}
          {{ 999 }}
        {% endif %}

      wallbox_charging: >
        {{ is_state(wallbox_status_sensor_var, wallbox_charging_state_var) }}

      force_charge_on: >
        {{ is_state(force_charge_switch_var, 'on') }}

      price_charging_enabled: >
        {{ is_state(price_charging_switch_var, 'on') }}

      discharge_blocked: >
        {{ is_state(discharge_block_switch_var, 'on') }}

      soc_valid: >
        {{ states(battery_soc_sensor_var) not in ['unknown', 'unavailable', 'none', 'None', ''] }}

      target_soc_valid: >
        {{ states(target_soc_number_var) not in ['unknown', 'unavailable', 'none', 'None', ''] }}

      price_valid: >
        {{ states(price_sensor_var) not in ['unknown', 'unavailable', 'none', 'None', ''] }}

      price_threshold_valid: >
        {{ states(price_threshold_number_var) not in ['unknown', 'unavailable', 'none', 'None', ''] }}

      manual_charge_active: >
        {{
          force_charge_on | bool(false)
          and soc_valid | bool(false)
          and target_soc_valid | bool(false)
          and (soc | float(999)) < (target_soc | float(0))
        }}

      manual_target_reached: >
        {{
          force_charge_on | bool(false)
          and soc_valid | bool(false)
          and target_soc_valid | bool(false)
          and (soc | float(999)) >= (target_soc | float(0))
        }}

      price_charge_active: >
        {{
          price_charging_enabled | bool(false)
          and price_valid | bool(false)
          and soc_valid | bool(false)
          and target_soc_valid | bool(false)
          and (required_slots | int(0)) > 0
          and (planned_charge_price_limit | float(999)) < 999
          and (price | float(999)) <= (planned_charge_price_limit | float(999)) + 0.00001
          and (
            not (use_price_ceiling_var | bool(false))
            or (
              price_threshold_valid | bool(false)
              and (price | float(999)) <= (price_threshold | float(0.16))
            )
          )
          and (soc | float(999)) < (target_soc | float(0))
          and (
            allow_price_charge_while_wallbox_var | bool(false)
            or not (wallbox_charging | bool(false))
          )
        }}

      price_expensive_for_discharge: >
        {{
          price_charging_enabled | bool(false)
          and price_valid | bool(false)
          and (price | float(999)) >= (discharge_price_limit | float(999))
        }}

      discharge_allowed: >
        {{
          not (wallbox_charging | bool(false))
          and not (discharge_blocked | bool(false))
          and price_expensive_for_discharge | bool(false)
        }}

  - choose:
      - alias: Sofortladen aktiv - Akku bis Ziel-SOC laden
        conditions:
          - condition: template
            value_template: "{{ manual_charge_active | bool(false) }}"
        sequence:
          - service: select.select_option
            target:
              entity_id: !input battery_mode_select
            data:
              option: "{{ control_mode_option_var }}"

          - service: number.set_value
            target:
              entity_id: !input battery_power_number
            data:
              value: "{{ charge_power_var | float(0) }}"

      - alias: Dynamische Preisautomatik - aktuelles Viertel ist günstig
        conditions:
          - condition: template
            value_template: "{{ price_charge_active | bool(false) }}"
        sequence:
          - service: select.select_option
            target:
              entity_id: !input battery_mode_select
            data:
              option: "{{ control_mode_option_var }}"

          - service: number.set_value
            target:
              entity_id: !input battery_power_number
            data:
              value: "{{ charge_power_var | float(0) }}"

      - alias: Wallbox lädt - Akku-Entladung stoppen
        conditions:
          - condition: template
            value_template: "{{ wallbox_charging | bool(false) }}"
        sequence:
          - service: select.select_option
            target:
              entity_id: !input battery_mode_select
            data:
              option: "{{ control_mode_option_var }}"

          - service: number.set_value
            target:
              entity_id: !input battery_power_number
            data:
              value: "{{ neutral_power_var | float(0) }}"

      - alias: Entladung gesperrt oder Preisautomatik wartet - Akku neutral halten
        conditions:
          - condition: template
            value_template: >
              {{
                discharge_blocked | bool(false)
                or (
                  price_charging_enabled | bool(false)
                  and not (price_expensive_for_discharge | bool(false))
                )
              }}
        sequence:
          - service: select.select_option
            target:
              entity_id: !input battery_mode_select
            data:
              option: "{{ control_mode_option_var }}"

          - service: number.set_value
            target:
              entity_id: !input battery_power_number
            data:
              value: "{{ neutral_power_var | float(0) }}"

    default:
      - alias: Strompreis teuer genug - Entladung freigeben
        service: number.set_value
        target:
          entity_id: !input battery_power_number
        data:
          value: "{{ neutral_power_var | float(0) }}"

      - service: select.select_option
        target:
          entity_id: !input battery_mode_select
        data:
          option: "{{ normal_mode_option_var }}"

  - if:
      - condition: template
        value_template: "{{ manual_target_reached | bool(false) }}"
    then:
      - service: input_boolean.turn_off
        target:
          entity_id: !input force_charge_switch

mode: restart
max_exceeded: silent
